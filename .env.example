# Copy to .env for local development only. Never commit a filled-in .env.
#
# In a deployed Databricks App these are NOT read from here -- they come
# from Databricks secrets in the "database" scope (see setup_secrets.py and
# secrets_helper.py). Locally, secrets_helper checks these plain environment
# variables first and only falls back to Databricks secrets if unset.

LAKEBASE_URL=postgresql://<role>:<password>@<instance>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

# Adzuna: https://developer.adzuna.com -- free app_id/app_key pair.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# USAJobs: https://developer.usajobs.gov -- free API key + registered email.
# Both required together; USAJOBS_EMAIL doubles as the User-Agent header
# USAJobs' API requires on every request. Leave both blank to skip this
# source entirely.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# RemoteOK needs no key -- nothing to set.

# Default harvest behavior when POST /jobs/sync is called with no body.
JOB_SEARCH_QUERIES=software engineer;data engineer;machine learning engineer
JOB_SEARCH_LOCATION=
JOB_SYNC_LIMIT=50
